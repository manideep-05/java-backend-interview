<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.interview.mastery</groupId>
    <artifactId>java-backend-interview-code-examples</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Java Backend Interview Mastery — Code Examples</name>
    <description>
        Runnable demonstrations for the Java Backend Interview Mastery repository.
        Pure Java + JUnit 5 only (no Spring/DB) so it compiles and tests run anywhere.
        Spring/JPA/SQL behavior is demonstrated in the chapter READMEs; this module
        proves the pure-Java claims (concurrency, collections, core semantics).
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
